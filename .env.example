# Copy to .env.local for local development. NEVER commit real values.

# Public (safe in the browser; every table is protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public URL of this site (used in email links). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY — secret key. Used only to send employee invitations.
# Set it in Vercel's environment settings, never in client code.
SUPABASE_SECRET_KEY=sb_secret_...

# Local database tests (plain PostgreSQL 16+)
TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
